{
  "definitions": [
    {
      "title": "Card List",
      "id": "card-list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Card List",
              "model": "card-list",
              "filter": "card-list",
              "classes": "view-1"
            }
          }
        }
      }
    },
    {
      "title": "Card List Card",
      "id": "card-list-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Card List Card",
              "model": "card-list-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "card-list",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "label": "View (minimum cards: view 1 = 3, view 2 = 3, view 3 = 4, view 4 = 2)",
          "valueType": "string",
          "value": "view-1",
          "options": [
            { "name": "View 1 - dark cards with description", "value": "view-1" },
            { "name": "View 2 - linked cards", "value": "view-2" },
            { "name": "View 3 - stories", "value": "view-3" },
            { "name": "View 4 - large action cards", "value": "view-4" }
          ]
        },
        {
          "component": "select",
          "name": "classes_layout",
          "label": "Mobile layout",
          "valueType": "string",
          "value": "",
          "options": [
            { "name": "Carousel", "value": "" },
            { "name": "Column (no carousel below 1024px)", "value": "column" }
          ]
        },
        {
          "component": "select",
          "name": "classes_color",
          "label": "Text color",
          "valueType": "string",
          "value": "",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "White (view 2)", "value": "card-list--white" }
          ]
        }
      ]
    },
    {
      "id": "card-list-item",
      "fields": [
        {
          "component": "reference",
          "name": "image",
          "label": "Image",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Image alt text",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "title",
          "label": "Title",
          "valueType": "string"
        },
        {
          "component": "textarea",
          "name": "description",
          "label": "Description (views 1 and 3)",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Page reference (views 2, 3 and 4)",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "linkText",
          "label": "Link text (view 3)",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "card-list",
      "components": [
        "card-list-item"
      ]
    }
  ]
